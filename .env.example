# Copy this file to .env and adjust values as needed.
# .env is loaded automatically by Spring Boot (spring.config.import) when the
# app runs from the project root; OS environment variables take precedence.
DB_URL=jdbc:postgresql://localhost:5433/paymentsys_db
DB_USERNAME=paymentsys_user
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
